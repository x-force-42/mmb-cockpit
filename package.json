{
  "name": "mmb-cockpit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Cockpit de Operações do Mr. Meeseeks Box — SPA Vite+React+TS",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "~6.0.2",
    "vite": "^6.4.2",
    "vitest": "^3.2.4"
  }
}
